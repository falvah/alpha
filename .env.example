# Local sandbox configuration. Docker is bound to 127.0.0.1 by default.
SANDBOX_MODE=true
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=
# In sandbox mode, a random persistent secret is generated under DATA_DIR.
# Outside sandbox mode a >=50-character random SECRET_KEY is mandatory.
SECRET_KEY=
