{
  "openapi": "3.1.0",
  "info": {
    "title": "Умный кредитный кабинет",
    "version": "1.2.0",
    "description": "Сессионный API и серверные формы кредитного кабинета."
  },
  "servers": [
    {
      "url": "http://localhost:8000"
    }
  ],
  "security": [
    {
      "sessionAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "sessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionid"
      }
    },
    "schemas": {
      "Application": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "reference": {
            "type": "string"
          },
          "product": {
            "type": "string",
            "enum": [
              "working",
              "growth",
              "bridge"
            ]
          },
          "amount": {
            "type": "string"
          },
          "months": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "submitted",
              "review",
              "info",
              "approved",
              "counteroffer",
              "rejected",
              "funded",
              "cancelled"
            ]
          },
          "status_label": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "payment": {
            "type": "string"
          },
          "offer": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "amount": {
                "type": "string"
              },
              "months": {
                "type": "integer"
              },
              "rate": {
                "type": "string"
              }
            }
          },
          "decision_note": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "scoring": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScorecardDecision"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ScorecardDecision": {
        "type": "object",
        "required": [
          "decision",
          "is_approved",
          "requires_manual_review",
          "requested_amount",
          "approved_amount",
          "reason_codes",
          "factors",
          "card_version"
        ],
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "decline",
              "review"
            ]
          },
          "is_approved": {
            "type": "boolean"
          },
          "requires_manual_review": {
            "type": "boolean"
          },
          "branch": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "mature",
              "young",
              null
            ]
          },
          "term_months": {
            "type": "integer"
          },
          "currency": {
            "const": "RUB"
          },
          "card_version": {
            "type": "string"
          },
          "simulated": {
            "const": true
          },
          "requested_amount": {
            "type": "number"
          },
          "pd": {
            "type": "number"
          },
          "logit": {
            "type": "number"
          },
          "score_points": {
            "type": "number"
          },
          "data_coverage": {
            "type": "number"
          },
          "approved_amount": {
            "type": [
              "number",
              "null"
            ]
          },
          "limit_amount": {
            "type": [
              "number",
              "null"
            ]
          },
          "annual_rate": {
            "type": [
              "number",
              "null"
            ]
          },
          "monthly_payment": {
            "type": [
              "number",
              "null"
            ]
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "factors": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "top_risk_factors": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "top_mitigants": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "ScorecardPayload": {
        "type": "object",
        "description": "Блоки заявка/application, обогащение/enrichment, документ/document, служебное/service. Формат и алиасы описаны в docs/scorecard.md.",
        "properties": {
          "заявка": {
            "type": "object"
          },
          "application": {
            "type": "object"
          },
          "обогащение": {
            "type": "object"
          },
          "enrichment": {
            "type": "object"
          },
          "документ": {
            "type": "object"
          },
          "document": {
            "type": "object"
          },
          "служебное": {
            "type": "object"
          },
          "service": {
            "type": "object"
          }
        }
      }
    }
  },
  "paths": {
    "/health/": {
      "get": {
        "summary": "Проверить БД и сервис",
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ok"
                    }
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/v1/products/": {
      "get": {
        "summary": "Каталог демопродуктов",
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "products": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object"
                      }
                    },
                    "simulated": {
                      "const": true
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Нет сессии"
          },
          "404": {
            "description": "Объект не найден или недоступен"
          }
        }
      }
    },
    "/api/v1/calculator/": {
      "get": {
        "summary": "Аннуитетный расчёт",
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "payment": {
                      "type": "string"
                    },
                    "total": {
                      "type": "string"
                    },
                    "rate": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Нет сессии"
          },
          "404": {
            "description": "Объект не найден или недоступен"
          },
          "400": {
            "description": "Неверные параметры кредита"
          }
        },
        "parameters": [
          {
            "name": "product",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "amount",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "months",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
    "/api/v1/applications/": {
      "get": {
        "summary": "Заявки текущего участника",
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Application"
                      }
                    },
                    "page": {
                      "type": "integer"
                    },
                    "pages": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Нет сессии"
          },
          "404": {
            "description": "Объект не найден или недоступен"
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
    "/api/v1/applications/{id}/": {
      "get": {
        "summary": "Карточка заявки",
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Application"
                }
              }
            }
          },
          "401": {
            "description": "Нет сессии"
          },
          "404": {
            "description": "Объект не найден или недоступен"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/login/": {
      "post": {
        "summary": "Вход в кабинет",
        "description": "CSRF-токен из HTML-формы + session cookie. Неверная версия/переход: redirect с flash-сообщением. Отсутствующий Content-Length: 411.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "csrfmiddlewaretoken": {
                    "type": "string"
                  },
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "format": "password"
                  }
                },
                "required": [
                  "csrfmiddlewaretoken",
                  "username",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Переход к странице результата, следующему шагу или форме с сообщением",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Ошибки полей, HTML-форма"
          },
          "403": {
            "description": "Недостаточно прав или неверный CSRF"
          },
          "404": {
            "description": "Заявка недоступна"
          },
          "411": {
            "description": "Требуется Content-Length"
          },
          "413": {
            "description": "Запрос более 6 МБ"
          },
          "429": {
            "description": "Лимит попыток за 15 минут"
          }
        },
        "security": []
      }
    },
    "/logout/": {
      "post": {
        "summary": "Завершить сессию",
        "description": "CSRF-токен из HTML-формы + session cookie. Неверная версия/переход: redirect с flash-сообщением. Отсутствующий Content-Length: 411.",
