                  },
                  "consent": {
                    "type": "string",
                    "enum": [
                      "on"
                    ]
                  }
                },
                "required": [
                  "csrfmiddlewaretoken",
                  "version",
                  "action"
                ]
              }
            }
          }
        },
        "responses": {
